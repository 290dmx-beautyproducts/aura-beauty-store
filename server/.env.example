# ===== Copy these into Render -> Environment (never put real keys in GitHub) =====

# Which service sends the M-Pesa prompt:  payhero (recommended)  or  daraja
PAYMENT_PROVIDER=payhero

# ---- PayHero (app.payhero.co.ke) ----
PAYHERO_API_USERNAME=               # from  API Keys  page after you add a key
PAYHERO_API_PASSWORD=               # from the same page
# (or paste the ready-made "Basic Auth Token" instead of the two lines above)
# PAYHERO_BASIC_AUTH=
PAYHERO_CHANNEL_ID=                 # Payment Channels -> My Payment Channels -> the ID of your BANK channel

# ---- This server ----
PUBLIC_URL=https://YOUR-APP.onrender.com   # your Render address (payment results are sent here)
CALLBACK_SECRET=                    # make up a long random text, e.g. 30 random letters and numbers
ALLOWED_ORIGIN=https://290dmx-beautyproducts.github.io   # your website address(es), comma separated

# ---- Only if you choose PAYMENT_PROVIDER=daraja ----
# DARAJA_ENV=sandbox
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_SHORTCODE=
# DARAJA_PASSKEY=
# DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# DARAJA_PARTYB=
# ACCOUNT_REFERENCE=AuraBeauty
# TRANSACTION_DESC=Aura order
