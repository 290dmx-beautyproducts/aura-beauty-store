# ===== Copy these into Render -> Environment (never put real keys in GitHub) =====

# Safaricom Daraja app credentials (developer.safaricom.co.ke -> My Apps)
DARAJA_ENV=sandbox                  # change to "production" when you go live
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=                   # Paybill number, or the Head Office number if you use a Till
DARAJA_PASSKEY=                     # Lipa Na M-Pesa Online passkey
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline    # or CustomerBuyGoodsOnline for a Till
DARAJA_PARTYB=                      # only for a Till: put the Till number here (leave empty for Paybill)

# This server
PUBLIC_URL=https://YOUR-APP.onrender.com   # your Render address (Safaricom sends payment results here)
CALLBACK_SECRET=                    # make up a long random text, e.g. 30 random letters and numbers
ALLOWED_ORIGIN=https://290dmx-beautyproducts.github.io   # your website address(es), comma separated

ACCOUNT_REFERENCE=AuraBeauty        # shown on the customer's M-Pesa message (max 12 characters)
TRANSACTION_DESC=Aura order         # max 13 characters
